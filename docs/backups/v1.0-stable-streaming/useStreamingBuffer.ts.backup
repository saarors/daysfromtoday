'use client';

import { useCallback, useEffect, useRef, useState } from 'react';
import { STREAMING_CONFIG } from './streaming-config';

type ChunkType = 'thinking' | 'content';

type PendingChunk = {
  type: ChunkType;
  text: string;
};

// 渐显配置 (可在 streaming-config.ts 中调整)
const CHAR_INTERVAL = STREAMING_CONFIG.CHAR_INTERVAL;
const CHARS_PER_BATCH = STREAMING_CONFIG.CHARS_PER_BATCH;

export interface StreamingBufferState {
  thinking: string;
  content: string;
  isStreaming: boolean;
  appendChunk: (type: ChunkType, text: string) => void;
  startStreaming: () => void;
  finishStreaming: () => void;
  reset: () => void;
  snapshotContent: () => string;
  snapshotThinking: () => string;
}

export function useStreamingBuffer(): StreamingBufferState {
  const [thinking, setThinking] = useState('');
  const [content, setContent] = useState('');
  const [isStreaming, setIsStreaming] = useState(false);

  const pendingChunksRef = useRef<PendingChunk[]>([]);
  const animationTimerRef = useRef<NodeJS.Timeout | null>(null);
  const thinkingStateRef = useRef('');
  const contentStateRef = useRef('');
  
  // 待渐显的字符缓冲区
  const thinkingBufferRef = useRef<string>('');
  const contentBufferRef = useRef<string>('');

  // 将接收到的 chunk 添加到缓冲区
  const drainPendingChunks = useCallback(() => {
    if (pendingChunksRef.current.length === 0) {
      return;
    }

    for (const chunk of pendingChunksRef.current) {
      if (!chunk.text) continue;
      if (chunk.type === 'thinking') {
        thinkingBufferRef.current += chunk.text;
      } else {
        contentBufferRef.current += chunk.text;
      }
    }

    pendingChunksRef.current = [];
  }, []);

  // 逐字符渐显动画
  const animateCharacters = useCallback(() => {
    let hasUpdates = false;

    // 从 thinking 缓冲区取字符
    if (thinkingBufferRef.current.length > 0) {
      const charsToShow = thinkingBufferRef.current.slice(0, CHARS_PER_BATCH);
      thinkingBufferRef.current = thinkingBufferRef.current.slice(CHARS_PER_BATCH);
      
      setThinking((prev) => {
        const next = prev + charsToShow;
        thinkingStateRef.current = next;
        return next;
      });
      hasUpdates = true;
    }

    // 从 content 缓冲区取字符
    if (contentBufferRef.current.length > 0) {
      const charsToShow = contentBufferRef.current.slice(0, CHARS_PER_BATCH);
      contentBufferRef.current = contentBufferRef.current.slice(CHARS_PER_BATCH);
      
      setContent((prev) => {
        const next = prev + charsToShow;
        contentStateRef.current = next;
        return next;
      });
      hasUpdates = true;
    }

    // 如果还有字符待显示,继续调度
    if (thinkingBufferRef.current.length > 0 || contentBufferRef.current.length > 0) {
      animationTimerRef.current = setTimeout(animateCharacters, CHAR_INTERVAL);
    } else {
      animationTimerRef.current = null;
    }
  }, []);

  const scheduleFlush = useCallback(() => {
    // 先将 pending chunks 转移到缓冲区
    drainPendingChunks();
    
    // 如果动画未在运行,启动动画
    if (animationTimerRef.current === null && 
        (thinkingBufferRef.current.length > 0 || contentBufferRef.current.length > 0)) {
      animateCharacters();
    }
  }, [drainPendingChunks, animateCharacters]);

  const appendChunk = useCallback(
    (type: ChunkType, text: string) => {
      if (!text) return;
      pendingChunksRef.current.push({ type, text });

      // 始终调度flush，让 requestAnimationFrame 自然合并
      scheduleFlush();
    },
    [scheduleFlush]
  );

  const startStreaming = useCallback(() => {
    if (animationTimerRef.current !== null) {
      clearTimeout(animationTimerRef.current);
      animationTimerRef.current = null;
    }
    pendingChunksRef.current = [];
    thinkingBufferRef.current = '';
    contentBufferRef.current = '';
    setThinking('');
    setContent('');
    thinkingStateRef.current = '';
    contentStateRef.current = '';
    setIsStreaming(true);
  }, []);

  const finishStreaming = useCallback(() => {
    console.log('🏁 finishStreaming 开始');
    console.log('   - pending chunks:', pendingChunksRef.current.length);
    console.log('   - thinking buffer:', thinkingBufferRef.current.length);
    console.log('   - content buffer:', contentBufferRef.current.length);
    console.log('   - thinking state:', thinkingStateRef.current.length);
    console.log('   - content state:', contentStateRef.current.length);
    
    // 🔥 关键修复: 直接处理所有数据,绕过动画系统
    
    // 第一步: 先将所有pending chunks累积到buffer
    for (const chunk of pendingChunksRef.current) {
      if (!chunk.text) continue;
      if (chunk.type === 'thinking') {
        thinkingBufferRef.current += chunk.text;
      } else {
        contentBufferRef.current += chunk.text;
      }
    }
    pendingChunksRef.current = [];
    
    // 第二步: 将所有buffer内容累积到最终内容
    const finalThinking = thinkingStateRef.current + thinkingBufferRef.current;
    const finalContent = contentStateRef.current + contentBufferRef.current;
    
    console.log('   - 累积后 thinking:', finalThinking.length);
    console.log('   - 累积后 content:', finalContent.length);
    
    // 清空buffer
    thinkingBufferRef.current = '';
    contentBufferRef.current = '';
    
    // 第三步: 同步更新state
    thinkingStateRef.current = finalThinking;
    contentStateRef.current = finalContent;
    setThinking(finalThinking);
    setContent(finalContent);
    
    console.log('🏁 finishStreaming 完成');
    
    // 停止动画
    if (animationTimerRef.current !== null) {
      clearTimeout(animationTimerRef.current);
      animationTimerRef.current = null;
    }
    
    setIsStreaming(false);
  }, []);

  const reset = useCallback(() => {
    if (animationTimerRef.current !== null) {
      clearTimeout(animationTimerRef.current);
      animationTimerRef.current = null;
    }
    pendingChunksRef.current = [];
    thinkingBufferRef.current = '';
    contentBufferRef.current = '';
    setThinking('');
    setContent('');
    thinkingStateRef.current = '';
    contentStateRef.current = '';
    setIsStreaming(false);
  }, []);

  const snapshotContent = useCallback(() => {
    const pendingContent = pendingChunksRef.current
      .filter((chunk) => chunk.type === 'content')
      .map((chunk) => chunk.text)
      .join('');
    
    return contentStateRef.current + contentBufferRef.current + pendingContent;
  }, []);

  const snapshotThinking = useCallback(() => {
    const pendingThinking = pendingChunksRef.current
      .filter((chunk) => chunk.type === 'thinking')
      .map((chunk) => chunk.text)
      .join('');
    return thinkingStateRef.current + thinkingBufferRef.current + pendingThinking;
  }, []);

  useEffect(() => {
    return () => {
      if (animationTimerRef.current !== null) {
        clearTimeout(animationTimerRef.current);
      }
      pendingChunksRef.current = [];
      thinkingBufferRef.current = '';
      contentBufferRef.current = '';
    };
  }, []);

  return {
    thinking,
    content,
    isStreaming,
    appendChunk,
    startStreaming,
    finishStreaming,
    reset,
    snapshotContent,
    snapshotThinking,
  };
}

