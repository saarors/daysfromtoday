{
  "name": "daysfromtoday",
  "version": "3.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:safe": "ulimit -n 10240 2>/dev/null || true && PORT=3009 next dev",
    "dev:check": "bash scripts/check-ports.sh && bash scripts/check-file-handles.sh",
    "dev:clean": "rm -rf .next && npm run dev:safe",
    "dev:reset": "rm -rf .next node_modules package-lock.json && npm install && npm run dev:safe",
    "port:check": "bash scripts/check-ports.sh",
    "port:stop": "bash scripts/stop-port.sh 3009",
    "health": "bash scripts/check-ports.sh && bash scripts/check-file-handles.sh",
    "diagnose": "bash scripts/diagnose.sh",
    "fix": "bash scripts/fix-common-issues.sh",
    "reset": "bash scripts/full-reset.sh",
    "restart": "bash scripts/restart-dev.sh",
    "build": "contentlayer build && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "contentlayer build",
    "test:supabase": "tsx scripts/test-supabase-connection.ts",
    "verify:supabase": "tsx scripts/verify-supabase-setup.ts",
    "holidays:init": "tsx scripts/generate-holidays.ts init",
    "holidays:update": "tsx scripts/generate-holidays.ts update",
    "holidays:validate": "tsx scripts/validate-holidays.ts",
    "images:upload": "tsx scripts/images/obsidian-upload.ts",
    "images:upload:all": "npm run images:upload \"/path/to/obsidian/vault\" blog && npm run images:upload \"/path/to/obsidian/vault\" philosophy && npm run images:upload \"/path/to/obsidian/vault\" tools",
    "images:test": "tsx scripts/images/test-upload.ts",
    "images:setup-r2": "tsx scripts/images/setup-r2-bucket.ts",
    "images:debug-r2": "tsx scripts/images/debug-r2-credentials.ts",
    "images:check-r2": "tsx scripts/images/check-r2-config.ts",
    "images:setup-public": "tsx scripts/images/setup-public-access.ts",
    "images:auto-upload": "tsx scripts/images/auto-upload-images.ts",
    "images:test-media": "tsx scripts/images/test-media-upload.ts",
    "seo:validate": "tsx scripts/seo-validator.ts",
    "ga:verify": "tsx scripts/verify-ga-config.ts",
    "seo-ga:check": "tsx scripts/comprehensive-seo-ga-check.ts",
    "content:sync": "./sync-content.sh",
    "content:convert": "tsx scripts/convert-md-to-mdx.ts",
    "obsidian:workflow": "tsx scripts/obsidian-workflow.ts",
    "dev:obsidian": "npm run obsidian:workflow",
    "sync:obsidian": "tsx scripts/sync-obsidian-to-content.ts",
    "sync:obsidian:watch": "tsx scripts/sync-obsidian-to-content.ts --watch --verbose",
    "sync:obsidian:all": "tsx scripts/sync-obsidian-to-content.ts --verbose",
    "obsidian:setup": "tsx scripts/setup-obsidian-plugins.ts",
    "obsidian:full-workflow": "npm run obsidian:setup && npm run sync:obsidian:watch",
    "blog:workflow": "tsx scripts/blog-publishing-workflow.ts",
    "blog:check": "tsx scripts/blog-publishing-workflow.ts --check",
    "blog:translate": "tsx scripts/blog-publishing-workflow.ts --translate",
    "blog:update": "tsx scripts/blog-publishing-workflow.ts --update",
    "blog:deploy": "tsx scripts/blog-publishing-workflow.ts --deploy",
    "blog:delete": "tsx scripts/delete-blog-post.ts",
    "images:organize": "tsx scripts/images/organize-images.ts",
    "images:organize:dry": "tsx scripts/images/organize-images.ts --dry-run --verbose",
    "images:cleanup": "tsx scripts/images/cleanup-unused.ts",
    "images:compress": "tsx scripts/images/compress-images.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.908.0",
    "@next/mdx": "^14.2.15",
    "@next/third-parties": "^14.2.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "@types/fs-extra": "^11.0.4",
    "@types/uuid": "^10.0.0",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.6",
    "@vercel/og": "^0.8.5",
    "clsx": "^2.1.1",
    "contentlayer": "^0.3.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.24",
    "fs-extra": "^11.3.2",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.1.6",
    "next": "^14.2.15",
    "next-contentlayer": "^0.3.4",
    "next-intl": "^4.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.65.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-code-titles": "^1.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-prism-plus": "^2.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^3.2.4",
    "chokidar": "^4.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
