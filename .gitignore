# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!env.local.template

# security and sensitive files
SECURITY_CONFIG.md
R2_CONFIG_ARCHIVE.md
*CREDENTIALS*.md
*SECRET*.md
*API_KEY*.md
*TOKEN*.md
*.key
*.pem
*.p12
*.pfx

# archived sensitive documents
docs/archive/*CREDENTIALS*.md
docs/archive/*SECRET*.md
docs/archive/*API_KEY*.md
docs/archive/*TOKEN*.md
docs/archive/*GA*.md
docs/archive/*R2*.md

# contentlayer
.contentlayer

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
